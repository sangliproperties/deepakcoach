generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  COACH
  ADMIN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  FAILED
}

enum PaymentStatus {
  CREATED
  PENDING
  PAID
  FAILED
  CANCELLED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
}

enum TestimonialStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  name         String
  passwordHash String
  phone        String?
  role         Role    @default(CUSTOMER)

  bookings      Booking[]
  reviews       Review[]
  notifications Notification[]
  sessions      Session[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Program {
  id           String   @id
  slug         String   @unique
  title        String
  tagline      String
  description  String
  durationMins Int
  priceInr     Int
  format       String
  inclusions   String[]
  eligibility  String
  expectations String
  featured     Boolean  @default(false)
  active       Boolean  @default(true)

  bookings     Booking[]
  testimonials Testimonial[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Availability {
  id       String   @id @default(cuid())
  startsAt DateTime
  endsAt   DateTime
  isOpen   Boolean  @default(true)

  bookings Booking[]

  createdAt DateTime @default(now())

  @@index([startsAt])
}

model Booking {
  id             String        @id @default(cuid())
  reference      String        @unique
  userId         String
  programId      String
  availabilityId String
  status         BookingStatus @default(PENDING)

  user         User         @relation(fields: [userId], references: [id])
  program      Program      @relation(fields: [programId], references: [id])
  availability Availability @relation(fields: [availabilityId], references: [id])

  payment Payment?

  // Opposite relations
  reviews       Review[]
  notifications Notification[]

  cancelledAt       DateTime?
  rescheduledFromId String?
  rescheduleCount   Int       @default(0)

  accessUrl          String?
  accessInstructions String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([availabilityId, status])
  @@index([userId])
  @@index([programId])
  @@index([createdAt])
}

model Payment {
  id                String        @id @default(cuid())
  bookingId         String        @unique
  providerOrderId   String?
  providerPaymentId String?
  amountInr         Int
  status            PaymentStatus @default(CREATED)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model Review {
  id        String       @id @default(cuid())
  bookingId String
  userId    String
  rating    Int
  text      String
  status    ReviewStatus @default(PENDING)
  booking   Booking      @relation(fields: [bookingId], references: [id])
  user      User         @relation(fields: [userId], references: [id])
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([bookingId])
  @@index([status])
}

model Testimonial {
  id        String            @id @default(cuid())
  quote     String
  name      String
  detail    String
  status    TestimonialStatus @default(DRAFT)
  programId String?
  program   Program?          @relation(fields: [programId], references: [id])
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}

model Notification {
  id        String             @id @default(cuid())
  userId    String
  bookingId String?
  type      String
  status    NotificationStatus @default(QUEUED)
  message   String
  user      User               @relation(fields: [userId], references: [id])
  booking   Booking?           @relation(fields: [bookingId], references: [id])
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([userId, createdAt])
}

model BusinessPolicy {
  id                  String   @id
  cancellationEnabled Boolean  @default(true)
  minimumNoticeHours  Int      @default(12)
  allowReschedule     Boolean  @default(true)
  rescheduleLimit     Int      @default(1)
  updatedAt           DateTime @updatedAt
}
