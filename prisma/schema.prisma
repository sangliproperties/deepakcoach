generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  FAILED
}

enum PaymentStatus {
  CREATED
  PENDING
  PAID
  FAILED
  CANCELLED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
}

enum TestimonialStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String
  passwordHash String
  phone        String?
  role         Role       @default(CUSTOMER)
  bookings     Booking[]
  reviews      Review[]
  notifications Notification[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Program {
  id           String     @id
  slug         String     @unique
  title        String
  description  String
  durationMins Int
  priceInr     Int
  active       Boolean    @default(true)
  bookings     Booking[]
  testimonials Testimonial[]
}

model Availability {
  id        String    @id @default(cuid())
  startsAt  DateTime
  endsAt    DateTime
  isOpen    Boolean   @default(true)
  bookings  Booking[]
  createdAt DateTime  @default(now())
}

model Booking {
  id             String        @id @default(cuid())
  reference      String        @unique
  userId         String
  programId      String
  availabilityId String
  status         BookingStatus @default(PENDING)
  user           User          @relation(fields: [userId], references: [id])
  program        Program       @relation(fields: [programId], references: [id])
  availability   Availability @relation(fields: [availabilityId], references: [id])
  payment        Payment?
  reviews        Review[]
  notifications  Notification[]
  cancelledAt    DateTime?
  rescheduledFromId String?
  rescheduleCount Int @default(0)
  accessUrl      String?
  accessInstructions String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([availabilityId, status])
}

model Payment {
  id                String        @id @default(cuid())
  bookingId         String        @unique
  provider          String
  providerOrderId   String?
  providerPaymentId String?
  amountInr         Int
  status            PaymentStatus @default(CREATED)
  booking           Booking       @relation(fields: [bookingId], references: [id])
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

model Review {
  id        String       @id @default(cuid())
  bookingId String
  userId    String
  rating    Int
  text      String
  status    ReviewStatus @default(PENDING)
  booking   Booking      @relation(fields: [bookingId], references: [id])
  user      User         @relation(fields: [userId], references: [id])
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([bookingId])
  @@index([status])
}

model Testimonial {
  id        String            @id @default(cuid())
  quote     String
  name      String
  detail    String
  status    TestimonialStatus @default(DRAFT)
  programId String?
  program   Program?          @relation(fields: [programId], references: [id])
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}

model Notification {
  id        String             @id @default(cuid())
  userId    String
  bookingId String?
  type      String
  status    NotificationStatus @default(QUEUED)
  message   String
  user      User               @relation(fields: [userId], references: [id])
  booking   Booking?           @relation(fields: [bookingId], references: [id])
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([userId, createdAt])
}

model BusinessPolicy {
  id              String   @id
  cancellationEnabled Boolean @default(true)
  minimumNoticeHours Int     @default(12)
  allowReschedule Boolean  @default(true)
  rescheduleLimit Int      @default(1)
  updatedAt       DateTime @updatedAt
}
